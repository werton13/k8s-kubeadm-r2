---
{# clusterid with NO_RDE_ prefix: the cluster is not managed by CSE/CAPVCD, so CSI must not try to update an RDE (otherwise 403 and the controller panics with --upgrade-rde) #}
apiVersion: v1
kind: ConfigMap
metadata:
  name: vcloud-csi-configmap
  namespace: kube-system
data:
  vcloud-csi-config.yaml: |+
    vcd:
      host: "{{ vcloud_url[:-4] }}"
      org: "{{ vcloud_orgname }}"
      vdc: "{{ vcloud_vdc }}"
      vAppName: "{{ vapp_name }}"
    clusterid: "NO_RDE_{{ k8s_cluster_id }}"
...
