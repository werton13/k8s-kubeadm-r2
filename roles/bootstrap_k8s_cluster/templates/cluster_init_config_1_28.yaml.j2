---
apiVersion: kubeadm.k8s.io/v1beta3
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: {{ HOST_IP }}
  bindPort: 6443
---
#apiServer:
#  certSANs:
#    - {{ master0_ip }}
#    - {{ master1_ip }}
#    - {{ master2_ip }}
#    - {{ k8s_controlPlane_Endpoint }}
#  extraArgs:
#    service-cluster-ip-range: {{ k8s_service_subnet }}  #10.96.0.0/12
#    advertise-address: {{ k8s_controlPlane_Endpoint }} #10.99.120.79

apiVersion: kubeadm.k8s.io/v1beta3
certificatesDir: /etc/kubernetes/pki
controllerManager:
  extraArgs:
    bind-address: 0.0.0.0
    cluster-cidr: {{ k8s_pod_subnet }} #10.244.0.0/22
    node-cidr-mask-size: "25"
    service-cluster-ip-range: {{ k8s_service_subnet }}  #10.96.0.0/12
    use-service-account-credentials: "true"
    node-monitor-grace-period: "30s"
    node-monitor-period: "4s"
dns: {}

kind: ClusterConfiguration
clusterName: "{{ k8s_cluster_name }}"
kubernetesVersion: {{ k8s_version_short }} #v1.24.0
controlPlaneEndpoint: {{ k8s_controlPlane_Endpoint }}:6443
networking:
  podSubnet: {{ k8s_pod_subnet }} # 10.244.0.0/22
  serviceSubnet: {{ k8s_service_subnet }} #10.96.0.0/12
scheduler:
  extraArgs:
    bind-address: 0.0.0.0
    
apiServer:
  extraArgs:
    oidc-issuer-url: "https://isso.mts.ru/auth/realms/mts"
    oidc-client-id: "kubernetes-public-cloud"
    oidc-username-claim: "userPrincipalName"
    oidc-groups-claim: "memberOf"
    oidc-ca-file:  "/etc/kubernetes/pki/kc-ca.pem"
    oidc-username-prefix: "oidc:"
    audit-log-format: "json"
    audit-log-maxage: "7"
    audit-log-maxbackup: "10"
    audit-log-maxsize: "100"
    audit-log-path: "/var/log/kube-audit/audit.log"
    audit-policy-file: "/etc/kubernetes/policies/audit-policy.yaml"

  certSANs:
    - {{ master0_ip }}
    - {{ master1_ip }}
    - {{ master2_ip }}
    - {{ k8s_controlPlane_Endpoint }}
  extraArgs:
    service-cluster-ip-range: {{ k8s_service_subnet }}  #10.96.0.0/12

  extraVolumes:
    - name: audit-policies
      hostPath: /etc/kubernetes/policies/
      mountPath: /etc/kubernetes/policies/
      readOnly: false
      pathType: Directory
    - name: audit-logs
      hostPath: /var/log/kube-audit/
      mountPath: /var/log/kube-audit/
      readOnly: false  
      pathType: Directory
#  extraVolumeMounts:
#    - name: audit-policies
#      mountPath: /etc/kubernetes/policies/
#      readOnly: true
#    - name: audit-logs
#      mountPath: /var/log/kube-audit/
#      readOnly: false  
  
---
apiVersion: kubeproxy.config.k8s.io/v1alpha1
kind: KubeProxyConfiguration
mode: "ipvs"
metricsBindAddress: "0.0.0.0:10249"
---
# https://kubernetes.io/docs/reference/config-api/kubelet-config.v1beta1/
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
containerLogMaxSize: "800Mi"
containerLogMaxFiles: 2
containerLogMaxWorkers: 5
containerLogMonitorInterval: "10s"
nodeStatusReportFrequency: "1m"

imageGCHighThresholdPercent: 70
imageGCLowThresholdPercent: 65
imageMaximumGCAge: "0s"
imageMinimumGCAge: "0s"

nodeStatusUpdateFrequency: "6s"

#podPidsLimit: 2000